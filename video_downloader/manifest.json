{
  "manifest_version": 3,
  "name": "网页视频下载器",
  "version": "1.1.0",
  "description": "自动检测网页视频，支持浏览器和迅雷下载",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "webRequest",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
